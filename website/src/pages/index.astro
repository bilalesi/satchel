---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { site } from "../site";
import overview from "../assets/shots/overview.png";
import login from "../assets/shots/item-login.png";
import quick from "../assets/shots/quick-access.png";
import popup from "../assets/shots/popup.png";
import sync from "../assets/shots/settings-sync.png";
import lock from "../assets/shots/lock.png";

// Screenshots are from the demo copy of the app (fake data), resized and converted to WebP at build time.
const features = [
  {
    title: "Every kind of secret, with the fields it needs.",
    text: "Logins with their one-time codes, API keys, database connections, webhooks, notes and SSH keys. File them into categories of your own.",
    img: login, alt: "A login item in Satchel showing username, hidden password and a live one-time code", wide: true,
  },
  {
    title: "Press ⌥ Space from any app.",
    text: "Type a few letters, press Return to copy. For apps a browser can't reach, Satchel can type the secret into the field you were in.",
    img: quick, alt: "The Quick Access panel searching for stri, with Stripe items at the top", wide: true,
  },
  {
    title: "Your logins, one click away in the browser.",
    text: "Works in Dia, Arc, Chrome and Firefox. A page only sees logins saved for its own site, and nothing is filled until you click.",
    img: popup, alt: "The Satchel browser extension showing two GitHub logins for the current site", wide: false,
  },
  {
    title: "Sync through a place you already own.",
    text: "A synced folder, GitHub, any git host, WebDAV or S3. Only sealed files leave your Mac, and you choose what stays on this one.",
    img: sync, alt: "Sync settings: synced folder, last synced a minute ago, categories to keep on this Mac", wide: false,
  },
  {
    title: "A workspace for each part of your life.",
    text: "Work, personal, a side project. Each one has its own password, Touch ID and sync.",
    img: lock, alt: "The lock screen with four workspaces: Personal, Work, Side project and Family", wide: true,
  },
];
---

<Base title="Satchel, a vault for your Mac" description="A native macOS vault for logins, API keys, database credentials and SSH keys. Encrypted on your Mac, synced through a place you choose. No account, no Satchel server.">
  <section class="hero wrap">
    <img class="icon" src="/satchel.png" alt="" width="72" height="72" />
    <h1>Every secret you work with, sealed on your Mac.</h1>
    <p class="lede">Passwords, API keys, databases and SSH keys in one native app. No account, no Satchel server.</p>
    <div class="actions">
      <a class="btn btn-primary" href={site.download}>Download the {site.trialDays}-day trial</a>
      <a class="btn btn-quiet" href="/pricing">{site.price}, once</a>
    </div>
    <p class="small muted">{site.requirements}.</p>
  </section>

  <section class="wrap">
    <div class="stage hero-shot">
      <Image src={overview} alt="Satchel's main window: workspaces, categories, a list of work secrets and an overview of items, sync and security" widths={[800, 1280, 2080]} sizes="(max-width: 1120px) 100vw, 1040px" loading="eager" />
    </div>
  </section>

  <div id="features">
    {features.map((f, i) => (
      <section class={`feature wrap ${i % 2 ? "flip" : ""}`} data-reveal>
        <div class="copy">
          <h2>{f.title}</h2>
          <p class="muted">{f.text}</p>
        </div>
        <div class="stage">
          <Image src={f.img} alt={f.alt} class={f.wide ? "" : "narrow"} widths={[600, 1000, 1600]} sizes="(max-width: 860px) 100vw, 640px" />
        </div>
      </section>
    ))}
  </div>

  <section class="section wrap trust">
    <h2>Private by design.</h2>
    <div class="points">
      <div>
        <h3>Encrypted on your Mac</h3>
        <p class="muted">Each item is sealed with XChaCha20-Poly1305 before it is written. Your master password is never stored.</p>
      </div>
      <div>
        <h3>No Satchel server</h3>
        <p class="muted">No account to create or leak. Your sync place only ever sees sealed files.</p>
      </div>
      <div>
        <h3>Honest about its limits</h3>
        <p class="muted">What it protects, and what it can't. <a href="/security">Read how Satchel keeps a secret</a>.</p>
      </div>
    </div>
  </section>

  <section class="section wrap closing">
    <h2>{site.price}, once. Try it free for {site.trialDays} days.</h2>
    <p class="muted">{site.fees}. No subscription.</p>
    <div class="actions">
      <a class="btn btn-primary" href={site.download}>Download the trial</a>
      <a class="btn btn-quiet" href="/pricing">See pricing</a>
    </div>
  </section>

  <script>
    // Features reveal once as they scroll into view. Only when motion is welcome: with reduced motion
    // (or no IntersectionObserver) the class is never added and everything stays plainly visible.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
      document.documentElement.classList.add("motion");
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
      }, { rootMargin: "0px 0px -15% 0px" });
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    }
  </script>
</Base>

<style>
  .hero { display: grid; justify-items: center; text-align: center; gap: 20px; padding-block: clamp(40px, 7vw, 88px) clamp(36px, 5vw, 56px); }
  .hero h1 { max-width: 18ch; }
  .hero .lede { max-width: 46ch; }
  .icon { width: 72px; height: 72px; }

  /* a quiet grey stage behind every screenshot, so the white app windows read on the white page */
  .stage { background: var(--mist); border-radius: 22px; padding: clamp(16px, 4vw, 48px); display: grid; place-items: center; }
  .stage :global(img) { width: 100%; height: auto; border-radius: 12px; box-shadow: 0 1px 2px rgba(31, 38, 35, 0.06), 0 16px 40px -20px rgba(31, 38, 35, 0.28); }
  .stage :global(img.narrow) { max-width: 400px; }
  .hero-shot { padding: clamp(12px, 3vw, 40px); }

  .feature { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(28px, 6vw, 80px); align-items: center; padding-block: clamp(48px, 8vw, 96px) 0; }
  .feature.flip { grid-template-columns: 1.2fr 0.8fr; }
  .feature.flip .copy { order: 2; }
  .copy { display: grid; gap: 14px; }
  .copy h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); }
  @media (max-width: 860px) {
    .feature, .feature.flip { grid-template-columns: 1fr; }
    .feature.flip .copy { order: 0; }
  }

  .trust { padding-top: clamp(80px, 12vw, 140px); }
  .trust h2 { margin-bottom: 32px; }
  .points { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .points > div { display: grid; gap: 8px; align-content: start; padding-top: 18px; border-top: 1px solid var(--line); }
  .points a { color: var(--ink); }
  @media (max-width: 760px) { .points { grid-template-columns: 1fr; } }

  .closing { display: grid; justify-items: center; gap: 14px; text-align: center; padding-top: 0; }
  .closing .actions { margin-top: 12px; justify-content: center; }

  /* Motion. One curve everywhere: fast start, long soft settle, no overshoot (nothing here was flicked).
     Only transform and opacity move, so it stays on the compositor. */
  @media (prefers-reduced-motion: no-preference) {
    /* page load: the hero arrives in a short stagger, then the screenshot */
    .hero > *, .hero-shot { animation: rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
    .hero > :nth-child(2) { animation-delay: 0.06s; }
    .hero > :nth-child(3) { animation-delay: 0.12s; }
    .hero > :nth-child(n + 4) { animation-delay: 0.18s; }
    .hero-shot { animation-delay: 0.28s; animation-duration: 1.2s; }
    .icon { animation-name: drop; }
    @keyframes rise { from { opacity: 0; transform: translateY(14px); } }
    @keyframes drop { from { opacity: 0; transform: translateY(-10px) scale(0.92); } }

    /* features: text rises, the stage settles, the screenshot slides in from its own side */
    :global(.motion) .feature .copy { opacity: 0; transform: translateY(18px); }
    :global(.motion) .feature .stage { opacity: 0; transform: scale(0.965); }
    :global(.motion) .feature .stage :global(img) { transform: translateX(36px); }
    :global(.motion) .feature.flip .stage :global(img) { transform: translateX(-36px); }
    :global(.motion) .feature .copy,
    :global(.motion) .feature .stage,
    :global(.motion) .feature .stage :global(img) {
      transition: opacity 0.8s ease, transform 1s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    :global(.motion) .feature .stage { transition-delay: 0.08s; }
    :global(.motion) .feature .stage :global(img) { transition-delay: 0.16s; }
    :global(.motion) .feature.in .copy,
    :global(.motion) .feature.in .stage,
    :global(.motion) .feature.in .stage :global(img) { opacity: 1; transform: none; }
  }

  /* Scroll-linked depth where the browser supports it: the hero window starts slightly tilted and
     settles flat as you scroll; feature screenshots drift a little inside their stage. Uses the
     separate translate/rotate properties so it never fights the reveal transform above. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-shot :global(img) {
        animation: settle linear both; animation-timeline: view(); animation-range: entry 10% cover 45%;
        transform-origin: 50% 100%;
      }
      @keyframes settle { from { rotate: x 9deg; scale: 0.94; } to { rotate: x 0deg; scale: 1; } }
      .hero-shot { perspective: 1400px; }

      .feature .stage :global(img) { animation: drift linear both; animation-timeline: view(); }
      @keyframes drift { from { translate: 0 22px; } to { translate: 0 -22px; } }
    }
  }
</style>
