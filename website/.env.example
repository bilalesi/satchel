# Copy to .env and fill in. .env is git-ignored. Bun loads it automatically.

# Cloudflare: https://dash.cloudflare.com/profile/api-tokens → Create Token → Custom token
# Permissions:
#   Account · Workers Scripts · Edit
#   Account · Account Settings · Read
#   Zone · Zone · Edit
#   Zone · DNS · Edit
#   Zone · Workers Routes · Edit
#   User · User Details · Read
# Account resources: your account. Zone resources: All zones from your account.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=1faa0ccd512bbf181c0fc88a4e4fcbfd

# Vercel: https://vercel.com/account/settings/tokens (scope: the team that owns echospace.dev)
VERCEL_TOKEN=
# Only if the domain belongs to a Vercel team, not your personal account (Team Settings → General → Team ID).
VERCEL_TEAM_ID=

DOMAIN=echospace.dev
SUBDOMAIN=satchel
WORKER_NAME=satchel-website
# Defaults to the repository this folder belongs to (gh repo view).
GITHUB_REPO=

# Optional: the workers.dev subdomain to register on a new Cloudflare account (defaults to your GitHub login).
WORKERS_SUBDOMAIN=
